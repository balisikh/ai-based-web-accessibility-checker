# Copy to .env.local and adjust as needed.
# AI tips: set OPENAI_API_KEY (or AI_API_KEY) below, then restart npm run dev.

# Optional: external Postgres. If unset, local PGlite files are used under ./data/lumen-pg
# DATABASE_URL=postgresql://user:password@localhost:5432/lumen

# Optional: PGlite data directory (default: ./data/lumen-pg)
# PGLITE_DATA_DIR=D:\lumen-data\pglite

# Rate limit for POST /api/scans (per IP). Dev server defaults to 120/min if unset.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
# For heavy local testing, use e.g. RATE_LIMIT_MAX=100 in .env.local

# AI enrichment (OpenAI-compatible Chat Completions) — paste your key after the =
OPENAI_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_ISSUES=5

# Use sample findings instead of Playwright/axe
# USE_DEMO_SCAN=1
