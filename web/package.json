{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev -p 4376 --webpack",
    "dev:low-mem": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev -p 4376 --webpack",
    "build": "next build --webpack",
    "build:low-mem": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start -p 4376",
    "start:low-mem": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next start -p 4376",
    "lint": "eslint",
    "validate:batch": "tsx scripts/validate-batch-snapshot.ts",
    "validate:copy": "tsx scripts/validate-product-copy.ts",
    "batch:rescan": "tsx scripts/batch-rescan.ts",
    "batch:apply-rescan": "tsx scripts/apply-batch-rescan.ts",
    "batch:sync": "npm run batch:rescan && npm run batch:apply-rescan && npm run validate:batch",
    "smoke:scan": "tsx scripts/smoke-scan.ts https://example.com",
    "test:responsive": "tsx scripts/responsive-viewport-check.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "screenshots:pdf": "tsx scripts/prepare-pdf-screenshots.ts",
    "docs:pdf": "npm run screenshots:pdf && node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/export-portfolio-pdf.ts",
    "ci": "npm run lint && npm run validate:copy && npm run validate:batch && npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "axe-core": "^4.12.1",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
